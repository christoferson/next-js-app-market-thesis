# Market-data source. Only demo is supported (live provider not selected).
MARKET_DATA_PROVIDER=demo

# Reserved for future server-side market-data caching.
# This setting does not require a cache implementation during D1.
MARKET_DATA_CACHE_TTL_SECONDS=900

# SEC EDGAR requires a declared User-Agent with contact info (not a secret).
# Example: MarketThesis/0.1 (contact: you@example.com)
EDGAR_USER_AGENT=

# EDINET API key (R3 — Japanese filings). Free key from the EDINET portal
# (Azure AD B2C registration). Server-side only; EDINET expects it as a
# query parameter, so the client must redact URLs when logging. Put the
# real key in .env.local, never in this example file.
EDINET_API_KEY=

# R2 runtime AI analysis. "bedrock" uses AWS Bedrock via the standard AWS
# credential chain (AWS_PROFILE locally, task role in deployment) — no keys
# here. "off" disables the What Changed narrative comparison.
RESEARCH_ANALYSIS_PROVIDER=bedrock
# Claude model on Bedrock used for filing comparison.
RESEARCH_ANALYSIS_MODEL_ID=anthropic.claude-sonnet-5
# AWS_REGION is read from the environment/profile as usual.
